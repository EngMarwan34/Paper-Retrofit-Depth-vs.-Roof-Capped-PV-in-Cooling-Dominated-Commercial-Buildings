@article{ibrahim_modeling_2018,
	title = {Modeling of the output current of a photovoltaic grid-connected system using random forests technique},
	volume = {36},
	issn = {0144-5987, 2048-4054},
	url = {http://journals.sagepub.com/doi/10.1177/0144598717723648},
	doi = {10.1177/0144598717723648},
	abstract = {This study presents a prediction technique for the output current of a photovoltaic grid-connected system by using random forests technique. Experimental data of a photovoltaic grid-connected system are used to train and validate the proposed model. Three statistical error values, namely root mean square error, mean bias error, and mean absolute percentage error, are used to evaluate the developed model. Moreover, the results of the proposed technique are compared with results obtained from an artificial neural network-based model to show the superiority of the proposed method. Results show that the proposed model accurately predicts the output current of the system. The root mean square error, mean absolute percentage error, and mean bias error values of the proposed method are 2.7482, 8.7151, and 2.5772\%, respectively. Moreover, the proposed model is faster than the artificial neural network-based model by 0.0801 s.},
	pages = {132--148},
	number = {1},
	journaltitle = {Energy Exploration \& Exploitation},
	shortjournal = {Energy Exploration \& Exploitation},
	author = {Ibrahim, Ibrahim A and Khatib, Tamer and Mohamed, Azah and Elmenreich, Wilfried},
	urldate = {2026-01-10},
	date = {2018-01},
	langid = {english},
	file = {PDF:C\:\\Users\\mohad\\Zotero\\storage\\QE898L7F\\Ibrahim et al. - 2018 - Modeling of the output current of a photovoltaic grid-connected system using random forests techniqu.pdf:application/pdf},
}

