	langid = {english},
	file = {PDF:C\:\\Users\\mohad\\Zotero\\storage\\YWCJUUVQ\\Promasa et al. - 2025 - Optimization of Sizing of Battery Energy Storage System for Residential Households by Load Forecasti.pdf:application/pdf},
